# GoTrue (Supabase Auth) configuration for local Cloud Agent development.
# Consumed by .cursor/scripts/start.sh, which runs the auth server from $HOME/gotrue.
# This is a local, self-contained dev setup; the JWT secret below is NOT a real secret.
GOTRUE_DB_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/eventsdb?search_path=auth
GOTRUE_DB_NAMESPACE=auth
GOTRUE_DB_MIGRATIONS_PATH=./migrations

GOTRUE_SITE_URL=http://127.0.0.1:5173
GOTRUE_URI_ALLOW_LIST=http://127.0.0.1:5173,http://127.0.0.1:5173/*,http://localhost:5173,http://localhost:5173/*

GOTRUE_API_HOST=127.0.0.1
PORT=9998
API_EXTERNAL_URL=http://127.0.0.1:9999/auth/v1

GOTRUE_JWT_SECRET=super-secret-local-dev-jwt-token-with-at-least-32-characters
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated

GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_HOST=localhost
GOTRUE_SMTP_PORT=2500
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com

GOTRUE_LOG_LEVEL=info
